{
  "id": "whatsapp-filomena-guard",
  "name": "WhatsApp Filomena Guard",
  "description": "Separates WhatsApp observation from configurable automatic response policies.",
  "activation": {
    "onCapabilities": ["hook"]
  },
  "configSchema": {
    "type": "object",
    "additionalProperties": false,
    "required": ["respond"],
    "properties": {
      "channel": { "type": "string", "default": "whatsapp" },
      "respond": {
        "type": "object",
        "additionalProperties": false,
        "required": ["direct", "groups"],
        "properties": {
          "direct": {
            "type": "object",
            "additionalProperties": false,
            "required": ["mode", "allowFrom"],
            "properties": {
              "mode": { "type": "string", "enum": ["allowlist", "disabled"] },
              "allowFrom": { "type": "array", "items": { "type": "string", "minLength": 1 } }
            }
          },
          "groups": {
            "type": "object",
            "additionalProperties": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "trigger": { "type": "string", "default": "@Filomena", "minLength": 1 },
                "triggerAliases": {
                  "type": "array",
                  "items": { "type": "string", "minLength": 1 },
                  "default": []
                },
                "allowRepliesToFilomena": { "type": "boolean", "default": true },
                "prefix": { "type": "boolean", "default": true }
              }
            }
          }
        }
      },
      "responsePrefix": { "type": "string", "default": "Filomena: ", "minLength": 1 },
      "stateFile": { "type": "string", "minLength": 1 },
      "maxTrackedMessageIds": {
        "type": "integer",
        "default": 512,
        "minimum": 1,
        "maximum": 10000
      }
    }
  }
}
