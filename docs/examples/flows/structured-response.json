{
  "artifactFormatVersion": 1,
  "catalogVersion": 1,
  "releaseId": "example-structured-response",
  "environment": "testnet",
  "workspace": {
    "characters": [
      {
        "id": "filomena",
        "displayName": "Filomena",
        "personality": "Playful, concise, and observant.",
        "graphId": "structured-response"
      }
    ],
    "graphs": [
      {
        "id": "structured-response",
        "formatVersion": 1,
        "role": "character",
        "characterId": "filomena",
        "entryNodeIds": ["input"],
        "nodes": [
          {"id": "input", "kind": "manual-input", "blockVersion": 1, "config": {}},
          {
            "id": "ai",
            "kind": "ai",
            "blockVersion": 1,
            "config": {
              "modelProfileId": "profile-filomena",
              "outputSchema": {
                "kind": "object",
                "fields": {
                  "texto": {"type": {"kind": "string"}, "required": true},
                  "humor": {"type": {"kind": "string"}, "required": false},
                  "reacao": {"type": {"kind": "string"}, "required": false}
                }
              }
            }
          },
          {
            "id": "send",
            "kind": "send",
            "blockVersion": 1,
            "config": {"destinationId": "fake-destination"}
          }
        ],
        "dataEdges": [
          {"source": {"nodeId": "input", "port": "text"}, "fieldPath": [], "target": {"nodeId": "ai", "port": "prompt"}},
          {"source": {"nodeId": "ai", "port": "output"}, "fieldPath": ["texto"], "target": {"nodeId": "send", "port": "body"}}
        ],
        "controlEdges": [
          {"source": {"nodeId": "input", "port": "success"}, "target": {"nodeId": "ai", "port": "run"}},
          {"source": {"nodeId": "ai", "port": "success"}, "target": {"nodeId": "send", "port": "run"}}
        ]
      }
    ],
    "modelProfiles": [
      {"profileId": "profile-filomena", "credentialReference": "fake-model-profile"}
    ],
    "modelProfileReferences": {"filomena": "profile-filomena"}
  }
}
