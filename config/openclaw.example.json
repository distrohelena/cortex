{
  "session": {
    "dmScope": "per-account-channel-peer"
  },
  "messages": {
    "inbound": {
      "byChannel": {
        "telegram": 0
      }
    }
  },
  "channels": {
    "whatsapp": {
      "dmPolicy": "open",
      "allowFrom": ["*"],
      "groupPolicy": "open",
      "groupAllowFrom": ["*"],
      "selfChatMode": false,
      "pluginHooks": {
        "messageReceived": true
      },
      "groups": {
        "*": {
          "requireMention": true
        },
        "<EXISTING_WHATSAPP_GROUP_JID>": {
          "requireMention": true,
          "systemPrompt": "The current triggering WhatsApp message is always the primary request."
        }
      }
    },
    "telegram": {
      "enabled": false,
      "dmPolicy": "disabled",
      "groupPolicy": "allowlist",
      "groups": {}
    }
  },
  "plugins": {
    "entries": {
      "whatsapp-filomena-guard": {
        "enabled": true,
        "config": {
          "channel": "whatsapp",
          "responsePrefix": "Filomena: ",
          "respond": {
            "direct": {
              "mode": "allowlist",
              "allowFrom": ["<HELENA_WHATSAPP_JID>"]
            },
            "groups": {
              "<EXISTING_WHATSAPP_GROUP_JID>": {
                "trigger": "@Filomena",
                "allowRepliesToFilomena": true,
                "prefix": true
              }
            }
          },
          "stateFile": "<OPENCLAW_STATE_DIR>\\whatsapp-filomena-guard.json",
          "maxTrackedMessageIds": 512
        }
      },
      "telegram-filomena-guard": {
        "enabled": false,
        "config": {
          "respond": {
            "direct": {
              "mode": "disabled",
              "chats": []
            },
            "groups": {}
          },
          "stateFile": "<OPENCLAW_STATE_DIR>\\telegram-filomena-guard.json",
          "maxTrackedMessageIds": 512
        }
      },
      "openclaw-memory-graphiti": {
        "enabled": true,
        "hooks": {
          "allowConversationAccess": true,
          "allowPromptInjection": true
        },
        "config": {
          "spicedb": {
            "endpoint": "localhost:50051",
            "token": "<SPICEDB_TOKEN>",
            "insecure": true
          },
          "graphiti": {
            "endpoint": "http://localhost:8000",
            "defaultGroupId": "replace-with-canonical-conversation-group-id"
          },
          "whatsapp": {
            "selfActorIds": ["<FILOMENA_BUSINESS_WHATSAPP_JID>"]
          },
          "subjectType": "agent",
          "subjectId": "main",
          "autoCapture": true,
          "autoRecall": true,
          "maxCaptureMessages": 10
        }
      }
    },
    "load": {
      "paths": [
        "C:\\dev\\filomena\\plugins\\openclaw-memory-graphiti",
        "C:\\dev\\filomena\\plugins\\whatsapp-filomena-guard",
        "C:\\dev\\filomena\\plugins\\telegram-filomena-guard"
      ]
    },
    "slots": {
      "memory": "openclaw-memory-graphiti"
    }
  },
  "agents": {
    "defaults": {
      "workspace": "C:\\dev\\filomena\\workspace",
      "model": {
        "primary": "lmstudio/google/gemma-4-e4b"
      }
    }
  }
}
