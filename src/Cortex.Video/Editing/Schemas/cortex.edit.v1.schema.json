{
  "type": "object",
  "properties": {
    "revision": {
      "type": "integer",
      "minimum": 1
    },
    "metadata": {
      "type": "object"
    },
    "project": {
      "$ref": "#/$defs/project"
    },
    "sources": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/source"
      },
      "minItems": 0
    },
    "beats": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/beat"
      },
      "minItems": 1
    },
    "schema": {
      "const": "cortex.edit.v1"
    }
  },
  "required": [
    "schema",
    "revision",
    "project",
    "sources",
    "beats"
  ],
  "additionalProperties": false,
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:cortex:edit:v1",
  "$defs": {
    "profile": {
      "type": "object",
      "properties": {
        "speaker": {
          "type": "string",
          "minLength": 1
        },
        "framing": {
          "type": "string",
          "minLength": 1
        },
        "orientation": {
          "type": "string",
          "minLength": 1
        },
        "delivery": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [],
      "additionalProperties": false
    },
    "project": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "format": {
          "type": "string",
          "enum": [
            "vertical",
            "horizontal",
            "square"
          ]
        },
        "aspect_ratio": {
          "type": "string",
          "pattern": "^[1-9][0-9]*:[1-9][0-9]*$"
        },
        "target_duration_sec": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "recording_defaults": {
          "$ref": "#/$defs/profile"
        }
      },
      "required": [
        "id",
        "title",
        "format",
        "aspect_ratio"
      ],
      "additionalProperties": false
    },
    "source": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "type": {
          "type": "string",
          "enum": [
            "video_file",
            "video_pool",
            "image"
          ]
        },
        "path": {
          "type": "string",
          "minLength": 1
        },
        "speaker": {
          "type": "string",
          "minLength": 1
        },
        "transcription": {
          "type": "boolean"
        }
      },
      "required": [
        "id",
        "type",
        "path"
      ],
      "additionalProperties": false
    },
    "search": {
      "type": "object",
      "properties": {
        "speaker": {
          "type": "string",
          "minLength": 1
        },
        "match": {
          "type": "string",
          "enum": [
            "exact",
            "semantic",
            "intent"
          ]
        },
        "text": {
          "type": "string",
          "minLength": 1
        },
        "meaning": {
          "type": "string",
          "minLength": 1
        },
        "source_id": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "speaker",
        "match"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "match": {
                "const": "exact"
              }
            },
            "required": [
              "match"
            ]
          },
          "then": {
            "required": [
              "text"
            ],
            "not": {
              "anyOf": [
                {
                  "required": [
                    "meaning"
                  ]
                }
              ]
            }
          }
        },
        {
          "if": {
            "properties": {
              "match": {
                "const": "semantic"
              }
            },
            "required": [
              "match"
            ]
          },
          "then": {
            "required": [
              "meaning"
            ],
            "not": {
              "anyOf": [
                {
                  "required": [
                    "text"
                  ]
                }
              ]
            }
          }
        },
        {
          "if": {
            "properties": {
              "match": {
                "const": "intent"
              }
            },
            "required": [
              "match"
            ]
          },
          "then": {
            "required": [
              "meaning"
            ],
            "not": {
              "anyOf": [
                {
                  "required": [
                    "text"
                  ]
                }
              ]
            }
          }
        }
      ]
    },
    "weights": {
      "type": "object",
      "properties": {
        "semantic_match": {
          "type": "number",
          "minimum": 0
        },
        "delivery": {
          "type": "number",
          "minimum": 0
        },
        "audio_quality": {
          "type": "number",
          "minimum": 0
        },
        "visual_quality": {
          "type": "number",
          "minimum": 0
        },
        "brevity": {
          "type": "number",
          "minimum": 0
        },
        "continuity": {
          "type": "number",
          "minimum": 0
        }
      },
      "required": [],
      "additionalProperties": false
    },
    "selection": {
      "type": "object",
      "properties": {
        "strategy": {
          "const": "best_take"
        },
        "max_duration_sec": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "prefer": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 0
        },
        "score": {
          "$ref": "#/$defs/weights"
        }
      },
      "required": [
        "strategy"
      ],
      "additionalProperties": false
    },
    "fallback": {
      "type": "object",
      "properties": {
        "type": {
          "const": "record"
        },
        "script": {
          "type": "string",
          "minLength": 1
        },
        "brief": {
          "type": "string",
          "minLength": 1
        },
        "target_duration_sec": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "recording": {
          "$ref": "#/$defs/profile"
        }
      },
      "required": [
        "type"
      ],
      "additionalProperties": false
    },
    "audio": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "none",
            "find_clip",
            "record"
          ]
        },
        "search": {
          "$ref": "#/$defs/search"
        },
        "selection": {
          "$ref": "#/$defs/selection"
        },
        "fallback": {
          "$ref": "#/$defs/fallback"
        },
        "script": {
          "type": "string",
          "minLength": 1
        },
        "brief": {
          "type": "string",
          "minLength": 1
        },
        "recording": {
          "$ref": "#/$defs/profile"
        },
        "target_duration_sec": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "require_exact_wording": {
          "type": "boolean"
        }
      },
      "required": [
        "type"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "type": {
                "const": "none"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "required": [],
            "not": {
              "anyOf": [
                {
                  "required": [
                    "search"
                  ]
                },
                {
                  "required": [
                    "selection"
                  ]
                },
                {
                  "required": [
                    "fallback"
                  ]
                },
                {
                  "required": [
                    "script"
                  ]
                },
                {
                  "required": [
                    "brief"
                  ]
                },
                {
                  "required": [
                    "recording"
                  ]
                },
                {
                  "required": [
                    "target_duration_sec"
                  ]
                },
                {
                  "required": [
                    "require_exact_wording"
                  ]
                }
              ]
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "find_clip"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "required": [
              "search"
            ],
            "not": {
              "anyOf": [
                {
                  "required": [
                    "script"
                  ]
                },
                {
                  "required": [
                    "brief"
                  ]
                },
                {
                  "required": [
                    "recording"
                  ]
                },
                {
                  "required": [
                    "target_duration_sec"
                  ]
                },
                {
                  "required": [
                    "require_exact_wording"
                  ]
                }
              ]
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "record"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "required": [],
            "not": {
              "anyOf": [
                {
                  "required": [
                    "search"
                  ]
                },
                {
                  "required": [
                    "selection"
                  ]
                },
                {
                  "required": [
                    "fallback"
                  ]
                }
              ]
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "record"
              }
            }
          },
          "then": {
            "anyOf": [
              {
                "required": [
                  "script"
                ]
              },
              {
                "required": [
                  "brief"
                ]
              }
            ]
          }
        }
      ]
    },
    "rect": {
      "type": "object",
      "properties": {
        "x": {
          "type": "number",
          "minimum": 0
        },
        "y": {
          "type": "number",
          "minimum": 0
        },
        "width": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "height": {
          "type": "number",
          "exclusiveMinimum": 0
        }
      },
      "required": [
        "x",
        "y",
        "width",
        "height"
      ],
      "additionalProperties": false
    },
    "focus": {
      "type": "object",
      "properties": {
        "type": {
          "const": "crop_zoom"
        },
        "target_text": {
          "type": "string",
          "minLength": 1
        },
        "source_rect_pixels": {
          "$ref": "#/$defs/rect"
        }
      },
      "required": [
        "type",
        "target_text"
      ],
      "additionalProperties": false
    },
    "visual": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "asset",
            "speaker",
            "speaker_with_overlay",
            "graphic",
            "title_card"
          ]
        },
        "source": {
          "type": "string",
          "minLength": 1
        },
        "speaker": {
          "type": "string",
          "minLength": 1
        },
        "enter": {
          "const": "cut"
        },
        "exit": {
          "const": "cut"
        },
        "duration_sec": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "focus": {
          "$ref": "#/$defs/focus"
        }
      },
      "required": [
        "type"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "type": {
                "const": "asset"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "required": [
              "source"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "speaker"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "required": [
              "speaker"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "speaker_with_overlay"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "required": [
              "speaker"
            ]
          }
        }
      ]
    },
    "aligned": {
      "type": "object",
      "properties": {
        "offset_sec": {
          "type": "number",
          "minimum": 0
        },
        "timing_granularity": {
          "type": "string",
          "enum": [
            "segment",
            "word",
            "frame"
          ]
        },
        "method": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "offset_sec",
        "timing_granularity",
        "method"
      ],
      "additionalProperties": false
    },
    "trigger": {
      "type": "object",
      "properties": {
        "spoken_phrase": {
          "type": "string",
          "minLength": 1
        },
        "resolved": {
          "$ref": "#/$defs/aligned"
        }
      },
      "required": [
        "spoken_phrase"
      ],
      "additionalProperties": false
    },
    "overlay": {
      "type": "object",
      "properties": {
        "text": {
          "type": "string",
          "minLength": 1
        },
        "style": {
          "type": "string",
          "minLength": 1
        },
        "trigger": {
          "$ref": "#/$defs/trigger"
        }
      },
      "required": [
        "text"
      ],
      "additionalProperties": false
    },
    "beat": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "purpose": {
          "type": "string",
          "minLength": 1
        },
        "audio": {
          "$ref": "#/$defs/audio"
        },
        "visual": {
          "$ref": "#/$defs/visual"
        },
        "overlay": {
          "$ref": "#/$defs/overlay"
        },
        "overlays": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/overlay"
          },
          "minItems": 0
        }
      },
      "required": [
        "id",
        "audio",
        "visual"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "audio": {
                "properties": {
                  "type": {
                    "const": "none"
                  }
                }
              }
            }
          },
          "then": {
            "properties": {
              "visual": {
                "required": [
                  "duration_sec"
                ]
              }
            }
          }
        }
      ]
    },
    "reference": {
      "type": "object",
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-fA-F0-9]{64}$"
        },
        "revision": {
          "type": "integer",
          "minimum": 1
        },
        "resolution_id": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "path",
        "sha256"
      ],
      "additionalProperties": false
    },
    "script_reference": {
      "allOf": [
        {
          "$ref": "#/$defs/reference"
        },
        {
          "required": [
            "revision"
          ]
        }
      ]
    },
    "resolution_reference": {
      "allOf": [
        {
          "$ref": "#/$defs/reference"
        },
        {
          "required": [
            "resolution_id"
          ]
        }
      ]
    },
    "media": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "source_id": {
          "type": "string",
          "minLength": 1
        },
        "path": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-fA-F0-9]{64}$"
        },
        "type": {
          "type": "string",
          "enum": [
            "video",
            "image"
          ]
        },
        "width": {
          "type": "integer",
          "minimum": 1
        },
        "height": {
          "type": "integer",
          "minimum": 1
        },
        "duration_sec": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "fps": {
          "type": "string",
          "pattern": "^[1-9][0-9]*(/[1-9][0-9]*)?$"
        },
        "speaker": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "id",
        "source_id",
        "path",
        "sha256",
        "type",
        "width",
        "height"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "type": {
                "const": "video"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "required": [
              "duration_sec",
              "fps"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "image"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "required": [],
            "not": {
              "anyOf": [
                {
                  "required": [
                    "duration_sec"
                  ]
                },
                {
                  "required": [
                    "fps"
                  ]
                }
              ]
            }
          }
        }
      ]
    },
    "match": {
      "type": "object",
      "properties": {
        "mode": {
          "type": "string",
          "enum": [
            "exact",
            "semantic",
            "intent"
          ]
        },
        "requested_meaning": {
          "type": "string",
          "minLength": 1
        },
        "requested_text": {
          "type": "string",
          "minLength": 1
        },
        "semantic_score": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "take_score": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "maximum": 1
        },
        "evaluated_metrics": {
          "type": "object",
          "additionalProperties": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          }
        },
        "unavailable_metrics": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 0
        },
        "evaluated_preferences": {
          "type": "object",
          "additionalProperties": {
            "type": "boolean"
          }
        },
        "unavailable_preferences": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 0
        },
        "basis": {
          "type": "string",
          "minLength": 1
        },
        "method": {
          "type": "string",
          "minLength": 1
        },
        "exact_wording_match": {
          "type": "boolean"
        }
      },
      "required": [
        "mode",
        "method"
      ],
      "additionalProperties": true
    },
    "provenance": {
      "type": "object",
      "properties": {
        "by": {
          "type": "string",
          "enum": [
            "resolver",
            "human"
          ]
        },
        "review_status": {
          "type": "string",
          "enum": [
            "pending",
            "accepted",
            "rejected"
          ]
        }
      },
      "required": [
        "by",
        "review_status"
      ],
      "additionalProperties": false
    },
    "candidate": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "media_id": {
          "type": "string",
          "minLength": 1
        },
        "source_in": {
          "type": "number",
          "minimum": 0
        },
        "source_out": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "transcript": {
          "type": "string",
          "minLength": 1
        },
        "speaker": {
          "type": "string",
          "minLength": 1
        },
        "timing_granularity": {
          "type": "string",
          "enum": [
            "segment",
            "word",
            "frame"
          ]
        },
        "match": {
          "$ref": "#/$defs/match"
        },
        "rank": {
          "type": "integer",
          "minimum": 1
        },
        "reason": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "id",
        "media_id",
        "source_in",
        "source_out",
        "transcript",
        "timing_granularity",
        "match",
        "rank",
        "reason"
      ],
      "additionalProperties": false
    },
    "observation": {
      "type": "object",
      "properties": {
        "status": {
          "type": "string",
          "enum": [
            "completed",
            "failed",
            "blocked"
          ]
        },
        "outcome": {
          "type": "string",
          "minLength": 1
        },
        "method": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "status",
        "outcome",
        "method"
      ],
      "additionalProperties": false
    },
    "audio_decision": {
      "type": "object",
      "properties": {
        "status": {
          "type": "string",
          "enum": [
            "matched",
            "intentional_none",
            "needs_recording",
            "needs_media",
            "needs_alignment",
            "needs_review",
            "blocked",
            "stale"
          ]
        },
        "recording_task_id": {
          "type": "string",
          "minLength": 1
        },
        "search": {
          "$ref": "#/$defs/observation"
        }
      },
      "required": [
        "status"
      ],
      "additionalProperties": false
    },
    "visual_decision": {
      "type": "object",
      "properties": {
        "status": {
          "type": "string",
          "enum": [
            "matched",
            "intentional_none",
            "needs_recording",
            "needs_media",
            "needs_alignment",
            "needs_review",
            "blocked",
            "stale"
          ]
        },
        "intent": {
          "$ref": "#/$defs/visual"
        },
        "media_id": {
          "type": "string",
          "minLength": 1
        },
        "resolved_focus": {
          "$ref": "#/$defs/focus"
        },
        "requirements": {
          "type": "array",
          "items": {
            "type": "object"
          },
          "minItems": 0
        }
      },
      "required": [
        "status",
        "intent"
      ],
      "additionalProperties": false
    },
    "decision": {
      "type": "object",
      "properties": {
        "beat_id": {
          "type": "string",
          "minLength": 1
        },
        "status": {
