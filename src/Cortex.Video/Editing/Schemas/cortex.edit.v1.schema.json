{
  "type": "object",
  "properties": {
    "revision": {
      "type": "integer",
      "minimum": 1
    },
    "metadata": {
      "type": "object"
    },
    "project": {
      "$ref": "#/$defs/project"
    },
    "sources": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/source"
      },
      "minItems": 0
    },
    "beats": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/beat"
      },
      "minItems": 1
    },
    "schema": {
      "const": "cortex.edit.v1"
    }
  },
  "required": [
    "schema",
    "revision",
    "project",
    "sources",
    "beats"
  ],
  "additionalProperties": false,
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:cortex:edit:v1",
  "$defs": {
    "profile": {
      "type": "object",
      "properties": {
        "speaker": {
          "type": "string",
          "minLength": 1
        },
        "framing": {
          "type": "string",
          "minLength": 1
        },
        "orientation": {
          "type": "string",
          "minLength": 1
        },
        "delivery": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [],
      "additionalProperties": false
    },
    "project": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "format": {
          "type": "string",
          "enum": [
            "vertical",
            "horizontal",
            "square"
          ]
        },
        "aspect_ratio": {
          "type": "string",
          "pattern": "^[1-9][0-9]*:[1-9][0-9]*$"
        },
        "target_duration_sec": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "recording_defaults": {
          "$ref": "#/$defs/profile"
        }
      },
      "required": [
        "id",
        "title",
        "format",
        "aspect_ratio"
      ],
      "additionalProperties": false
    },
    "source": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "type": {
          "type": "string",
          "enum": [
            "video_file",
            "video_pool",
            "image"
          ]
        },
        "path": {
          "type": "string",
          "minLength": 1
        },
        "speaker": {
          "type": "string",
          "minLength": 1
        },
        "transcription": {
          "type": "boolean"
        }
      },
      "required": [
        "id",
        "type",
        "path"
      ],
      "additionalProperties": false
    },
    "search": {
      "type": "object",
      "properties": {
        "speaker": {
          "type": "string",
          "minLength": 1
        },
        "match": {
          "type": "string",
          "enum": [
            "exact",
            "semantic",
            "intent"
          ]
        },
        "text": {
          "type": "string",
          "minLength": 1
        },
        "meaning": {
          "type": "string",
          "minLength": 1
        },
        "source_id": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "speaker",
        "match"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "match": {
                "const": "exact"
              }
            },
            "required": [
              "match"
            ]
          },
          "then": {
            "required": [
              "text"
            ],
            "not": {
              "anyOf": [
                {
                  "required": [
                    "meaning"
                  ]
                }
              ]
            }
          }
        },
        {
          "if": {
            "properties": {
              "match": {
                "const": "semantic"
              }
            },
            "required": [
              "match"
            ]
          },
          "then": {
            "required": [
              "meaning"
            ],
            "not": {
              "anyOf": [
                {
                  "required": [
                    "text"
                  ]
                }
              ]
            }
          }
        },
        {
          "if": {
            "properties": {
              "match": {
                "const": "intent"
              }
            },
            "required": [
              "match"
            ]
          },
          "then": {
            "required": [
              "meaning"
            ],
            "not": {
              "anyOf": [
                {
                  "required": [
                    "text"
                  ]
                }
              ]
            }
          }
        }
      ]
    },
    "weights": {
      "type": "object",
      "properties": {
        "semantic_match": {
          "type": "number",
          "minimum": 0
        },
        "delivery": {
          "type": "number",
          "minimum": 0
        },
        "audio_quality": {
          "type": "number",
          "minimum": 0
        },
        "visual_quality": {
          "type": "number",
          "minimum": 0
        },
        "brevity": {
          "type": "number",
          "minimum": 0
        },
        "continuity": {
          "type": "number",
          "minimum": 0
        }
      },
      "required": [],
      "additionalProperties": false
    },
    "selection": {
      "type": "object",
      "properties": {
        "strategy": {
          "const": "best_take"
        },
        "max_duration_sec": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "prefer": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 0
        },
        "score": {
          "$ref": "#/$defs/weights"
        }
      },
      "required": [
        "strategy"
      ],
      "additionalProperties": false
    },
    "fallback": {
      "type": "object",
      "properties": {
        "type": {
          "const": "record"
        },
        "script": {
          "type": "string",
          "minLength": 1
        },
        "brief": {
          "type": "string",
          "minLength": 1
        },
        "target_duration_sec": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "recording": {
          "$ref": "#/$defs/profile"
        }
      },
      "required": [
        "type"
      ],
      "additionalProperties": false
    },
    "audio": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "none",
            "find_clip",
            "record"
          ]
        },
        "search": {
          "$ref": "#/$defs/search"
        },
        "selection": {
          "$ref": "#/$defs/selection"
        },
        "fallback": {
          "$ref": "#/$defs/fallback"
        },
        "script": {
          "type": "string",
          "minLength": 1
        },
        "brief": {
          "type": "string",
          "minLength": 1
        },
        "recording": {
          "$ref": "#/$defs/profile"
        },
        "target_duration_sec": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "require_exact_wording": {
          "type": "boolean"
        }
      },
      "required": [
        "type"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "type": {
                "const": "none"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "required": [],
            "not": {
              "anyOf": [
                {
                  "required": [
                    "search"
                  ]
                },
                {
                  "required": [
                    "selection"
                  ]
                },
                {
                  "required": [
                    "fallback"
                  ]
                },
                {
                  "required": [
                    "script"
                  ]
                },
                {
                  "required": [
                    "brief"
                  ]
                },
                {
                  "required": [
                    "recording"
                  ]
                },
                {
                  "required": [
                    "target_duration_sec"
                  ]
                },
                {
                  "required": [
                    "require_exact_wording"
                  ]
                }
              ]
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "find_clip"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "required": [
              "search"
            ],
            "not": {
              "anyOf": [
                {
                  "required": [
                    "script"
                  ]
                },
                {
                  "required": [
                    "brief"
                  ]
                },
                {
                  "required": [
                    "recording"
                  ]
                },
                {
                  "required": [
                    "target_duration_sec"
                  ]
                },
                {
                  "required": [
                    "require_exact_wording"
                  ]
                }
              ]
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "record"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "required": [],
            "not": {
              "anyOf": [
                {
                  "required": [
                    "search"
                  ]
                },
                {
                  "required": [
                    "selection"
                  ]
                },
                {
                  "required": [
                    "fallback"
                  ]
                }
              ]
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "record"
              }
            }
          },
          "then": {
            "anyOf": [
              {
                "required": [
                  "script"
                ]
              },
              {
                "required": [
                  "brief"
                ]
              }
            ]
          }
        }
      ]
    },
    "rect": {
      "type": "object",
      "properties": {
        "x": {
          "type": "number",
          "minimum": 0
        },
        "y": {
          "type": "number",
          "minimum": 0
        },
        "width": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "height": {
          "type": "number",
          "exclusiveMinimum": 0
        }
      },
      "required": [
        "x",
        "y",
        "width",
        "height"
      ],
      "additionalProperties": false
    },
    "focus": {
      "type": "object",
      "properties": {
        "type": {
          "const": "crop_zoom"
        },
        "target_text": {
          "type": "string",
          "minLength": 1
        },
        "source_rect_pixels": {
          "$ref": "#/$defs/rect"
        }
      },
      "required": [
        "type",
        "target_text"
      ],
      "additionalProperties": false
    },
    "visual": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "asset",
            "speaker",
            "speaker_with_overlay",
            "graphic",
            "title_card"
          ]
        },
        "source": {
          "type": "string",
          "minLength": 1
        },
        "speaker": {
          "type": "string",
          "minLength": 1
        },
        "enter": {
          "const": "cut"
        },
        "exit": {
          "const": "cut"
        },
        "duration_sec": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "focus": {
          "$ref": "#/$defs/focus"
        }
      },
      "required": [
        "type"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "type": {
                "const": "asset"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "required": [
              "source"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "speaker"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "required": [
              "speaker"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "speaker_with_overlay"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "required": [
              "speaker"
            ]
          }
        }
      ]
    },
    "aligned": {
      "type": "object",
      "properties": {
        "offset_sec": {
          "type": "number",
          "minimum": 0
        },
        "timing_granularity": {
          "type": "string",
          "enum": [
            "segment",
            "word",
            "frame"
          ]
        },
        "method": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "offset_sec",
        "timing_granularity",
        "method"
      ],
      "additionalProperties": false
    },
    "trigger": {
      "type": "object",
      "properties": {
        "spoken_phrase": {
          "type": "string",
          "minLength": 1
        },
        "resolved": {
          "$ref": "#/$defs/aligned"
        }
      },
      "required": [
        "spoken_phrase"
      ],
      "additionalProperties": false
    },
    "overlay": {
      "type": "object",
      "properties": {
        "text": {
          "type": "string",
          "minLength": 1
        },
        "style": {
          "type": "string",
          "minLength": 1
        },
        "trigger": {
          "$ref": "#/$defs/trigger"
        }
      },
      "required": [
        "text"
      ],
      "additionalProperties": false
    },
    "beat": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "purpose": {
          "type": "string",
          "minLength": 1
        },
        "audio": {
          "$ref": "#/$defs/audio"
        },
        "visual": {
          "$ref": "#/$defs/visual"
        },
        "overlay": {
          "$ref": "#/$defs/overlay"
        },
        "overlays": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/overlay"
          },
          "minItems": 0
        }
      },
      "required": [
        "id",
        "audio",
        "visual"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "audio": {
                "properties": {
                  "type": {
                    "const": "none"
                  }
                }
              }
            }
          },
          "then": {
            "properties": {
              "visual": {
                "required": [
                  "duration_sec"
                ]
              }
            }
          }
        }
      ]
    }
  }
}
