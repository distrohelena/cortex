{
  "type": "object",
  "properties": {
    "metadata": {
      "type": "object"
    },
    "project_id": {
      "type": "string",
      "minLength": 1
    },
    "script_ref": {
      "$ref": "#/$defs/script_reference"
    },
    "resolution_id": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "const": "resolved"
    },
    "timebase": {
      "const": "seconds"
    },
    "review_status": {
      "type": "string",
      "enum": [
        "pending",
        "accepted",
        "rejected"
      ]
    },
    "media": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/media"
      },
      "minItems": 0
    },
    "timeline": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/timeline"
      },
      "minItems": 1
    },
    "duration_sec": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "target_duration_sec": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "render_requirements": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 0
    },
    "recording_task_resolutions": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/task_resolution"
      },
      "minItems": 0
    },
    "notices": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/notice"
      },
      "minItems": 0
    },
    "edit_plan_ref": {
      "$ref": "#/$defs/resolution_reference"
    },
    "recording_tasks_ref": {
      "$ref": "#/$defs/resolution_reference"
    },
    "schema": {
      "const": "cortex.edit.resolved.v1"
    }
  },
  "required": [
    "schema",
    "project_id",
    "script_ref",
    "resolution_id",
    "status",
    "timebase",
    "review_status",
    "media",
    "timeline",
    "duration_sec",
    "render_requirements",
    "recording_task_resolutions",
    "edit_plan_ref",
    "recording_tasks_ref"
  ],
  "additionalProperties": false,
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:cortex:edit:resolved:v1",
  "$defs": {
    "rect": {
      "type": "object",
      "properties": {
        "x": {
          "type": "number",
          "minimum": 0
        },
        "y": {
          "type": "number",
          "minimum": 0
        },
        "width": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "height": {
          "type": "number",
          "exclusiveMinimum": 0
        }
      },
      "required": [
        "x",
        "y",
        "width",
        "height"
      ],
      "additionalProperties": false
    },
    "focus": {
      "type": "object",
      "properties": {
        "type": {
          "const": "crop_zoom"
        },
        "target_text": {
          "type": "string",
          "minLength": 1
        },
        "source_rect_pixels": {
          "$ref": "#/$defs/rect"
        }
      },
      "required": [
        "type",
        "target_text"
      ],
      "additionalProperties": false
    },
    "aligned": {
      "type": "object",
      "properties": {
        "offset_sec": {
          "type": "number",
          "minimum": 0
        },
        "timing_granularity": {
          "type": "string",
          "enum": [
            "segment",
            "word",
            "frame"
          ]
        },
        "method": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "offset_sec",
        "timing_granularity",
        "method"
      ],
      "additionalProperties": false
    },
    "trigger": {
      "type": "object",
      "properties": {
        "spoken_phrase": {
          "type": "string",
          "minLength": 1
        },
        "resolved": {
          "$ref": "#/$defs/aligned"
        }
      },
      "required": [
        "spoken_phrase"
      ],
      "additionalProperties": false
    },
    "overlay": {
      "type": "object",
      "properties": {
        "text": {
          "type": "string",
          "minLength": 1
        },
        "style": {
          "type": "string",
          "minLength": 1
        },
        "trigger": {
          "$ref": "#/$defs/trigger"
        }
      },
      "required": [
        "text"
      ],
      "additionalProperties": false
    },
    "reference": {
      "type": "object",
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-fA-F0-9]{64}$"
        },
        "revision": {
          "type": "integer",
          "minimum": 1
        },
        "resolution_id": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "path",
        "sha256"
      ],
      "additionalProperties": false
    },
    "script_reference": {
      "allOf": [
        {
          "$ref": "#/$defs/reference"
        },
        {
          "required": [
            "revision"
          ]
        }
      ]
    },
    "resolution_reference": {
      "allOf": [
        {
          "$ref": "#/$defs/reference"
        },
        {
          "required": [
            "resolution_id"
          ]
        }
      ]
    },
    "media": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "source_id": {
          "type": "string",
          "minLength": 1
        },
        "path": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-fA-F0-9]{64}$"
        },
        "type": {
          "type": "string",
          "enum": [
            "video",
            "image",
            "audio"
          ]
        },
        "width": {
          "type": "integer",
          "minimum": 1
        },
        "height": {
          "type": "integer",
          "minimum": 1
        },
        "duration_sec": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "fps": {
          "type": "string",
          "pattern": "^[1-9][0-9]*(/[1-9][0-9]*)?$"
        },
        "speaker": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "id",
        "source_id",
        "path",
        "sha256",
        "type",
        "width",
        "height"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "type": {
                "const": "video"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "required": [
              "duration_sec",
              "fps"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "image"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "required": [],
            "not": {
              "anyOf": [
                {
                  "required": [
                    "duration_sec"
                  ]
                },
                {
                  "required": [
                    "fps"
                  ]
                }
              ]
            }
          }
        }
      ]
    },
    "match": {
      "type": "object",
      "properties": {
        "mode": {
          "type": "string",
          "enum": [
            "exact",
            "semantic",
            "intent"
          ]
        },
        "requested_meaning": {
          "type": "string",
          "minLength": 1
        },
        "requested_text": {
          "type": "string",
          "minLength": 1
        },
        "semantic_score": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "take_score": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "maximum": 1
        },
        "evaluated_metrics": {
          "type": "object",
          "additionalProperties": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          }
        },
        "unavailable_metrics": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 0
        },
        "evaluated_preferences": {
          "type": "object",
          "additionalProperties": {
            "type": "boolean"
          }
        },
        "unavailable_preferences": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 0
        },
        "basis": {
          "type": "string",
          "minLength": 1
        },
        "method": {
          "type": "string",
          "minLength": 1
        },
        "exact_wording_match": {
          "type": "boolean"
        }
      },
      "required": [
        "mode",
        "method"
      ],
      "additionalProperties": true
    },
    "provenance": {
      "type": "object",
      "properties": {
        "by": {
          "type": "string",
          "enum": [
            "resolver",
            "human"
          ]
        },
        "review_status": {
          "type": "string",
          "enum": [
            "pending",
            "accepted",
            "rejected"
          ]
        }
      },
      "required": [
        "by",
        "review_status"
      ],
      "additionalProperties": false
    },
    "pickup": {
      "type": "object",
      "properties": {
        "media_id": {
          "type": "string",
          "minLength": 1
        },
        "source_id": {
          "type": "string",
          "minLength": 1
        },
        "path": {
          "type": "string",
          "minLength": 1
        },
        "source_in": {
          "type": "number",
          "minimum": 0
        },
        "source_out": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "transcript": {
          "type": "string",
          "minLength": 1
        },
        "timing_granularity": {
          "type": "string",
          "enum": [
            "segment",
            "word",
            "frame"
          ]
        },
        "match": {
          "$ref": "#/$defs/match"
        },
        "selection": {
          "$ref": "#/$defs/provenance"
        }
      },
      "required": [
        "media_id",
        "source_id",
        "path",
        "source_in",
        "source_out",
        "transcript",
        "timing_granularity",
        "match",
        "selection"
      ],
      "additionalProperties": false
    },
    "binding": {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "none",
            "clip",
            "image",
            "graphic",
            "title_card"
          ]
        },
        "media_id": {
          "type": "string",
          "minLength": 1
        },
        "source_in": {
          "type": "number",
          "minimum": 0
        },
        "source_out": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "focus": {
          "$ref": "#/$defs/focus"
        },
        "recipe": {
          "type": "object"
        }
      },
      "required": [
        "kind"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "kind": {
                "const": "clip"
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "required": [
              "media_id",
              "source_in",
              "source_out"
            ],
            "not": {
              "anyOf": [
                {
                  "required": [
                    "recipe"
                  ]
                }
              ]
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "image"
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "required": [
              "media_id"
            ],
            "not": {
              "anyOf": [
                {
                  "required": [
                    "source_in"
                  ]
                },
                {
                  "required": [
                    "source_out"
                  ]
                },
                {
                  "required": [
                    "recipe"
                  ]
                }
              ]
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "none"
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "required": [],
            "not": {
              "anyOf": [
                {
                  "required": [
                    "media_id"
                  ]
                },
                {
                  "required": [
                    "source_in"
                  ]
                },
                {
                  "required": [
                    "source_out"
                  ]
                },
                {
                  "required": [
                    "focus"
                  ]
                },
                {
                  "required": [
                    "recipe"
                  ]
                }
              ]
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "graphic"
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "required": [
              "recipe"
            ],
            "not": {
              "anyOf": [
                {
                  "required": [
                    "media_id"
                  ]
                },
                {
                  "required": [
                    "source_in"
                  ]
                },
                {
                  "required": [
                    "source_out"
                  ]
                }
              ]
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "title_card"
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "required": [
              "recipe"
            ],
            "not": {
              "anyOf": [
                {
                  "required": [
                    "media_id"
                  ]
                },
                {
                  "required": [
                    "source_in"
                  ]
                },
                {
                  "required": [
                    "source_out"
                  ]
                }
              ]
            }
          }
        }
      ]
    },
    "timeline": {
      "type": "object",
      "properties": {
        "beat_id": {
          "type": "string",
          "minLength": 1
        },
        "start": {
          "type": "number",
          "minimum": 0
        },
        "end": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "audio": {
          "$ref": "#/$defs/binding",
          "allOf": [
            {
              "$ref": "#/$defs/binding"
            },
            {
              "properties": {
                "kind": {
                  "type": "string",
                  "enum": [
                    "none",
                    "clip"
                  ]
                }
              }
            }
          ]
        },
        "video": {
          "$ref": "#/$defs/binding",
          "allOf": [
            {
              "$ref": "#/$defs/binding"
            },
            {
              "properties": {
                "kind": {
                  "type": "string",
                  "enum": [
                    "clip",
                    "image",
                    "graphic",
                    "title_card"
                  ]
                }
              }
            }
          ]
        },
        "enter": {
          "const": "cut"
        },
        "exit": {
          "const": "cut"
        },
        "match": {
          "$ref": "#/$defs/match"
        },
        "overlays": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/overlay"
          },
          "minItems": 0
        }
      },
      "required": [
        "beat_id",
        "start",
        "end",
        "audio",
        "video",
        "enter",
        "exit"
      ],
      "additionalProperties": false
    },
    "task_resolution": {
      "type": "object",
      "properties": {
        "recording_task": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "const": "resolved"
        },
        "resolved_by": {
          "$ref": "#/$defs/pickup"
        }
      },
      "required": [
        "recording_task",
        "status",
        "resolved_by"
      ],
      "additionalProperties": false
    },
    "notice": {
      "type": "object",
      "properties": {
        "code": {
          "type": "string",
          "minLength": 1
        },
        "message": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "code",
        "message"
      ],
      "additionalProperties": false
    }
  }
}
