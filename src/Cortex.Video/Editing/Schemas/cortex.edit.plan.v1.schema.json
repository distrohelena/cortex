{
  "type": "object",
  "properties": {
    "metadata": {
      "type": "object"
    },
    "project_id": {
      "type": "string",
      "minLength": 1
    },
    "script_ref": {
      "$ref": "#/$defs/script_reference"
    },
    "resolution_id": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "type": "string",
      "enum": [
        "incomplete",
        "complete",
        "blocked",
        "stale"
      ]
    },
    "media": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/media"
      },
      "minItems": 0
    },
    "beats": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/decision"
      },
      "minItems": 1
    },
    "unresolved_requirements": {
      "type": "array",
      "items": {
        "type": "object"
      },
      "minItems": 0
    },
    "schema": {
      "const": "cortex.edit.plan.v1"
    }
  },
  "required": [
    "schema",
    "project_id",
    "script_ref",
    "resolution_id",
    "status",
    "media",
    "beats",
    "unresolved_requirements"
  ],
  "additionalProperties": false,
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:cortex:edit:plan:v1",
  "$defs": {
    "rect": {
      "type": "object",
      "properties": {
        "x": {
          "type": "number",
          "minimum": 0
        },
        "y": {
          "type": "number",
          "minimum": 0
        },
        "width": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "height": {
          "type": "number",
          "exclusiveMinimum": 0
        }
      },
      "required": [
        "x",
        "y",
        "width",
        "height"
      ],
      "additionalProperties": false
    },
    "focus": {
      "type": "object",
      "properties": {
        "type": {
          "const": "crop_zoom"
        },
        "target_text": {
          "type": "string",
          "minLength": 1
        },
        "source_rect_pixels": {
          "$ref": "#/$defs/rect"
        }
      },
      "required": [
        "type",
        "target_text"
      ],
      "additionalProperties": false
    },
    "visual": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "asset",
            "speaker",
            "speaker_with_overlay",
            "graphic",
            "title_card"
          ]
        },
        "source": {
          "type": "string",
          "minLength": 1
        },
        "speaker": {
          "type": "string",
          "minLength": 1
        },
        "enter": {
          "const": "cut"
        },
        "exit": {
          "const": "cut"
        },
        "duration_sec": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "focus": {
          "$ref": "#/$defs/focus"
        }
      },
      "required": [
        "type"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "type": {
                "const": "asset"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "required": [
              "source"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "speaker"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "required": [
              "speaker"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "speaker_with_overlay"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "required": [
              "speaker"
            ]
          }
        }
      ]
    },
    "reference": {
      "type": "object",
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-fA-F0-9]{64}$"
        },
        "revision": {
          "type": "integer",
          "minimum": 1
        },
        "resolution_id": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "path",
        "sha256"
      ],
      "additionalProperties": false
    },
    "script_reference": {
      "allOf": [
        {
          "$ref": "#/$defs/reference"
        },
        {
          "required": [
            "revision"
          ]
        }
      ]
    },
    "media": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "source_id": {
          "type": "string",
          "minLength": 1
        },
        "path": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-fA-F0-9]{64}$"
        },
        "type": {
          "type": "string",
          "enum": [
            "video",
            "image"
          ]
        },
        "width": {
          "type": "integer",
          "minimum": 1
        },
        "height": {
          "type": "integer",
          "minimum": 1
        },
        "duration_sec": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "fps": {
          "type": "string",
          "pattern": "^[1-9][0-9]*(/[1-9][0-9]*)?$"
        },
        "speaker": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "id",
        "source_id",
        "path",
        "sha256",
        "type",
        "width",
        "height"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "type": {
                "const": "video"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "required": [
              "duration_sec",
              "fps"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "image"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "required": [],
            "not": {
              "anyOf": [
                {
                  "required": [
                    "duration_sec"
                  ]
                },
                {
                  "required": [
                    "fps"
                  ]
                }
              ]
            }
          }
        }
      ]
    },
    "match": {
      "type": "object",
      "properties": {
        "mode": {
          "type": "string",
          "enum": [
            "exact",
            "semantic",
            "intent"
          ]
        },
        "requested_meaning": {
          "type": "string",
          "minLength": 1
        },
        "requested_text": {
          "type": "string",
          "minLength": 1
        },
        "semantic_score": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "take_score": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "maximum": 1
        },
        "evaluated_metrics": {
          "type": "object",
          "additionalProperties": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          }
        },
        "unavailable_metrics": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 0
        },
        "evaluated_preferences": {
          "type": "object",
          "additionalProperties": {
            "type": "boolean"
          }
        },
        "unavailable_preferences": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 0
        },
        "basis": {
          "type": "string",
          "minLength": 1
        },
        "method": {
          "type": "string",
          "minLength": 1
        },
        "exact_wording_match": {
          "type": "boolean"
        }
      },
      "required": [
        "mode",
        "method"
      ],
      "additionalProperties": true
    },
    "provenance": {
      "type": "object",
      "properties": {
        "by": {
          "type": "string",
          "enum": [
            "resolver",
            "human"
          ]
        },
        "review_status": {
          "type": "string",
          "enum": [
            "pending",
            "accepted",
            "rejected"
          ]
        }
      },
      "required": [
        "by",
        "review_status"
      ],
      "additionalProperties": false
    },
    "candidate": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "media_id": {
          "type": "string",
          "minLength": 1
        },
        "source_in": {
          "type": "number",
          "minimum": 0
        },
        "source_out": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "transcript": {
          "type": "string",
          "minLength": 1
        },
        "speaker": {
          "type": "string",
          "minLength": 1
        },
        "timing_granularity": {
          "type": "string",
          "enum": [
            "segment",
            "word",
            "frame"
          ]
        },
        "match": {
          "$ref": "#/$defs/match"
        },
        "rank": {
          "type": "integer",
          "minimum": 1
        },
        "reason": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "id",
        "media_id",
        "source_in",
        "source_out",
        "transcript",
        "timing_granularity",
        "match",
        "rank",
        "reason"
      ],
      "additionalProperties": false
    },
    "observation": {
      "type": "object",
      "properties": {
        "status": {
          "type": "string",
          "enum": [
            "completed",
            "failed",
            "blocked"
          ]
        },
        "outcome": {
          "type": "string",
          "minLength": 1
        },
        "method": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "status",
        "outcome",
        "method"
      ],
      "additionalProperties": false
    },
    "audio_decision": {
      "type": "object",
      "properties": {
        "status": {
          "type": "string",
          "enum": [
            "matched",
            "intentional_none",
            "needs_recording",
            "needs_media",
            "needs_alignment",
            "needs_review",
            "blocked",
            "stale"
          ]
        },
        "recording_task_id": {
          "type": "string",
          "minLength": 1
        },
        "search": {
          "$ref": "#/$defs/observation"
        }
      },
      "required": [
        "status"
      ],
      "additionalProperties": false
    },
    "visual_decision": {
      "type": "object",
      "properties": {
        "status": {
          "type": "string",
          "enum": [
            "matched",
            "intentional_none",
            "needs_recording",
            "needs_media",
            "needs_alignment",
            "needs_review",
            "blocked",
            "stale"
          ]
        },
        "intent": {
          "$ref": "#/$defs/visual"
        },
        "media_id": {
          "type": "string",
          "minLength": 1
        },
        "resolved_focus": {
          "$ref": "#/$defs/focus"
        },
        "requirements": {
          "type": "array",
          "items": {
            "type": "object"
          },
          "minItems": 0
        }
      },
      "required": [
        "status",
        "intent"
      ],
      "additionalProperties": false
    },
    "decision": {
      "type": "object",
      "properties": {
        "beat_id": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "type": "string",
          "enum": [
            "matched",
            "intentional_none",
            "needs_recording",
            "needs_media",
            "needs_alignment",
            "needs_review",
            "blocked",
            "stale"
          ]
        },
        "audio": {
          "$ref": "#/$defs/audio_decision"
        },
        "visual": {
          "$ref": "#/$defs/visual_decision"
        },
        "candidates": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/candidate"
          },
          "minItems": 0
        },
        "selected_candidate_id": {
          "type": "string",
          "minLength": 1
        },
        "selection": {
          "$ref": "#/$defs/provenance"
        }
      },
      "required": [
        "beat_id",
        "status",
        "audio",
        "visual",
        "candidates"
      ],
      "additionalProperties": false
    }
  }
}
