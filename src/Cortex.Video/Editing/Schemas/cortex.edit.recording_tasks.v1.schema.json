{
  "type": "object",
  "properties": {
    "metadata": {
      "type": "object"
    },
    "project_id": {
      "type": "string",
      "minLength": 1
    },
    "script_ref": {
      "$ref": "#/$defs/script_reference"
    },
    "resolution_id": {
      "type": "string",
      "minLength": 1
    },
    "recording_tasks": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/task"
      },
      "minItems": 0
    },
    "schema": {
      "const": "cortex.edit.recording_tasks.v1"
    }
  },
  "required": [
    "schema",
    "project_id",
    "script_ref",
    "resolution_id",
    "recording_tasks"
  ],
  "additionalProperties": false,
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:cortex:edit:recording_tasks:v1",
  "$defs": {
    "profile": {
      "type": "object",
      "properties": {
        "speaker": {
          "type": "string",
          "minLength": 1
        },
        "framing": {
          "type": "string",
          "minLength": 1
        },
        "orientation": {
          "type": "string",
          "minLength": 1
        },
        "delivery": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [],
      "additionalProperties": false
    },
    "reference": {
      "type": "object",
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-fA-F0-9]{64}$"
        },
        "revision": {
          "type": "integer",
          "minimum": 1
        },
        "resolution_id": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "path",
        "sha256"
      ],
      "additionalProperties": false
    },
    "script_reference": {
      "allOf": [
        {
          "$ref": "#/$defs/reference"
        },
        {
          "required": [
            "revision"
          ]
        }
      ]
    },
    "match": {
      "type": "object",
      "properties": {
        "mode": {
          "type": "string",
          "enum": [
            "exact",
            "semantic",
            "intent"
          ]
        },
        "requested_meaning": {
          "type": "string",
          "minLength": 1
        },
        "requested_text": {
          "type": "string",
          "minLength": 1
        },
        "semantic_score": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "take_score": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "maximum": 1
        },
        "evaluated_metrics": {
          "type": "object",
          "additionalProperties": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          }
        },
        "unavailable_metrics": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 0
        },
        "evaluated_preferences": {
          "type": "object",
          "additionalProperties": {
            "type": "boolean"
          }
        },
        "unavailable_preferences": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 0
        },
        "basis": {
          "type": "string",
          "minLength": 1
        },
        "method": {
          "type": "string",
          "minLength": 1
        },
        "exact_wording_match": {
          "type": "boolean"
        }
      },
      "required": [
        "mode",
        "method"
      ],
      "additionalProperties": true
    },
    "provenance": {
      "type": "object",
      "properties": {
        "by": {
          "type": "string",
          "enum": [
            "resolver",
            "human"
          ]
        },
        "review_status": {
          "type": "string",
          "enum": [
            "pending",
            "accepted",
            "rejected"
          ]
        }
      },
      "required": [
        "by",
        "review_status"
      ],
      "additionalProperties": false
    },
    "query_match": {
      "type": "object",
      "properties": {
        "mode": {
          "type": "string",
          "enum": [
            "exact",
            "semantic",
            "intent"
          ]
        },
        "requested_meaning": {
          "type": "string",
          "minLength": 1
        },
        "requested_text": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "mode"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "mode": {
                "const": "exact"
              }
            },
            "required": [
              "mode"
            ]
          },
          "then": {
            "required": [
              "requested_text"
            ],
            "not": {
              "anyOf": [
                {
                  "required": [
                    "requested_meaning"
                  ]
                }
              ]
            }
          }
        },
        {
          "if": {
            "properties": {
              "mode": {
                "const": "semantic"
              }
            },
            "required": [
              "mode"
            ]
          },
          "then": {
            "required": [
              "requested_meaning"
            ],
            "not": {
              "anyOf": [
                {
                  "required": [
                    "requested_text"
                  ]
                }
              ]
            }
          }
        },
        {
          "if": {
            "properties": {
              "mode": {
                "const": "intent"
              }
            },
            "required": [
              "mode"
            ]
          },
          "then": {
            "required": [
              "requested_meaning"
            ],
            "not": {
              "anyOf": [
                {
                  "required": [
                    "requested_text"
                  ]
                }
              ]
            }
          }
        }
      ]
    },
    "pickup": {
      "type": "object",
      "properties": {
        "media_id": {
          "type": "string",
          "minLength": 1
        },
        "source_id": {
          "type": "string",
          "minLength": 1
        },
        "path": {
          "type": "string",
          "minLength": 1
        },
        "source_in": {
          "type": "number",
          "minimum": 0
        },
        "source_out": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "transcript": {
          "type": "string",
          "minLength": 1
        },
        "timing_granularity": {
          "type": "string",
          "enum": [
            "segment",
            "word",
            "frame"
          ]
        },
        "match": {
          "$ref": "#/$defs/match"
        },
        "selection": {
          "$ref": "#/$defs/provenance"
        }
      },
      "required": [
        "media_id",
        "source_id",
        "path",
        "source_in",
        "source_out",
        "transcript",
        "timing_granularity",
        "match",
        "selection"
      ],
      "additionalProperties": false
    },
    "task": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "beat_id": {
          "type": "string",
          "minLength": 1
        },
        "reason": {
          "type": "string",
          "enum": [
            "no_suitable_clip_found",
            "script_requires_exact_wording",
        "script_requests_recording"
          ]
        },
        "script": {
          "type": "string",
          "minLength": 1
        },
        "brief": {
          "type": "string",
          "minLength": 1
        },
        "match": {
          "$ref": "#/$defs/query_match"
        },
        "target_duration_sec": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "recording": {
          "$ref": "#/$defs/profile"
        },
        "status": {
          "type": "string",
          "enum": [
            "needs_recording",
            "recorded",
            "needs_review",
            "resolved",
            "stale"
          ]
        },
        "resolved_by": {
          "$ref": "#/$defs/pickup"
        }
      },
      "required": [
        "id",
        "beat_id",
        "reason",
        "match",
        "recording",
        "status"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "anyOf": [
            {
              "required": [
                "script"
              ]
            },
            {
              "required": [
                "brief"
              ]
            }
          ]
        },
        {
          "if": {
            "properties": {
              "status": {
                "const": "resolved"
              }
            },
            "required": [
              "status"
            ]
          },
          "then": {
            "required": [
              "resolved_by"
            ]
          }
        }
      ]
    }
  }
}
