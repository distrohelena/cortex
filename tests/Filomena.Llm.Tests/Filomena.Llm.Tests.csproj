<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit.v3" Version="3.0.1" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.5">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <None Include="../fixtures/boundary-interpreter-corpus.json" Link="boundary-interpreter-corpus.json" CopyToOutputDirectory="PreserveNewest" />
    <None Include="../fixtures/validator-hardset.json" Link="validator-hardset.json" CopyToOutputDirectory="PreserveNewest" />
    <None Include="../fixtures/typed-flow-slice4*.json" Link="%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <None Include="../fixtures/typed-flow-slice1.json" Link="typed-flow-slice1.json" CopyToOutputDirectory="PreserveNewest" />
    <None Include="../fixtures/typed-flow-slice35*.json" Link="%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <None Include="../fixtures/typed-flow-slice36*.json" Link="%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <None Include="../fixtures/typed-flow-slice37.json" Link="typed-flow-slice37.json" CopyToOutputDirectory="PreserveNewest" />
    <Compile Include="../Filomena.Core.Tests/Flows/FakeTimeProvider.cs" Link="Support/FakeTimeProvider.cs" />
    <None Include="../fixtures/typed-flow-slice2.json" Link="typed-flow-slice2.json" CopyToOutputDirectory="PreserveNewest" />
    <None Include="../fixtures/typed-flow-slice3.json" Link="typed-flow-slice3.json" CopyToOutputDirectory="PreserveNewest" />
    <ProjectReference Include="../../src/Filomena.Core/Filomena.Core.csproj" />
    <ProjectReference Include="../../src/Filomena.Llm/Filomena.Llm.csproj" />
    <ProjectReference Include="../../src/Filomena.App/Filomena.App.csproj" />
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>
</Project>
