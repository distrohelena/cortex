<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit.v3" Version="3.0.1" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.5">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/Cortex.Core/Cortex.Core.csproj" />
    <ProjectReference Include="../../src/Cortex.Inference/Cortex.Inference.csproj" />
    <ProjectReference Include="../Cortex.Plugin.TestFixture/Cortex.Plugin.TestFixture.csproj" ReferenceOutputAssembly="false" />
    <InternalsVisibleTo Include="Filomena.App.Tests" />
  </ItemGroup>
  <Target Name="CopyPluginFixture" AfterTargets="Build">
    <MSBuild Projects="../Cortex.Plugin.TestFixture/Cortex.Plugin.TestFixture.csproj" Targets="GetTargetPath" BuildInParallel="false">
      <Output TaskParameter="TargetOutputs" ItemName="PluginFixtureTarget" />
    </MSBuild>
    <ItemGroup><PluginFixtureFiles Include="@(PluginFixtureTarget);@(PluginFixtureTarget->'%(RootDir)%(Directory)%(Filename).deps.json')" /></ItemGroup>
    <Copy SourceFiles="@(PluginFixtureFiles)" DestinationFolder="$(OutDir)plugin-fixture" />
  </Target>
</Project>
