<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit.v3" Version="3.0.1" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.5">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/Cortex.Core/Cortex.Core.csproj" />
    <ProjectReference Include="../../src/Cortex.Inference/Cortex.Inference.csproj" />
  </ItemGroup>
  <ItemGroup>
    <Compile Include="../Shared/SystemOneTestSupport.cs" Link="Support/SystemOneTestSupport.cs" />
    <Compile Include="../Shared/LocalModels/LocalModelManifest.cs" Link="Support/LocalModels/LocalModelManifest.cs" />
    <Compile Include="../Shared/LocalModels/LocalModelCache.cs" Link="Support/LocalModels/LocalModelCache.cs" />
    <Compile Include="../Shared/LocalModels/LocalServerProcess.cs" Link="Support/LocalModels/LocalServerProcess.cs" />
  </ItemGroup>
</Project>
